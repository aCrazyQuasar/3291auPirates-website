// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Robot {
  id          Int    @id @default(autoincrement())
  name        String
  year        Int
  season      String
  description String
  githubLink  String @default("https://github.com/AuPiratesFIRST")
  
  // Storage for the Image (.png)
  image       String // Stores the UploadThing CDN URL for displaying the image
  imageKey    String // Stores the unique UploadThing key needed for deletion

  // Storage for the 3D Model (.glb)
  model       String // Stores the UploadThing CDN URL for loading the 3D asset
  modelKey    String // Stores the unique UploadThing key needed for deletion
}

model Admin {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
}